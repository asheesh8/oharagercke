# ------------------------------------------------------------------
# O'Hara & Gercke — environment configuration
# Copy to `.env` (and/or `.env.local`) and fill in.
# The public site runs WITHOUT any of these (static seed fallback).
# The admin backend + persistence require the database vars below.
# ------------------------------------------------------------------

# --- Auth (required for admin) ---
# 7-day session signing secret. Generate: `openssl rand -hex 32`
JWT_SECRET=

# Fallback admin login used only when DATABASE_URL is NOT set (local dev).
# When a database is connected, the admin user lives in the AdminUser table
# (created by `pnpm db:seed`) instead.
ADMIN_EMAIL=admin@oharagercke.com
# bcrypt hash of your password. Generate:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD',10))"
ADMIN_PASSWORD_HASH=
# Used only by the seed script to create the DB admin user:
ADMIN_PASSWORD=

# --- Database (Supabase Postgres) ---
# From Supabase → Project Settings → Database → Connection string.
# DATABASE_URL uses the pooled (pgBouncer, port 6543) connection for the app.
# DIRECT_URL uses the direct (port 5432) connection for migrations.
DATABASE_URL=
DIRECT_URL=

# --- Media storage (Supabase Storage) ---
# When set, admin image uploads go to a Supabase Storage bucket;
# otherwise they are written to /public/uploads (local dev only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
